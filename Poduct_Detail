        </div>

        <p id="ingredientsText" class="mt-7 text-base leading-8 font-medium">
          Fresh local milk, authentic Greek yogurt cultures, banana, natural Cambodian palm sugar, and live probiotics.
        </p>

        <div class="mt-8 border-t border-brand-green/20 pt-6">
          <h4 class="font-black uppercase tracking-wide text-sm">Product Highlights</h4>

          <div class="mt-4 space-y-3">
            <div class="flex items-center gap-3">
              <span class="w-9 h-9 rounded-full bg-brand-green text-brand-bg flex items-center justify-center">✓</span>
              <span class="font-semibold">Keep refrigerated (2–4°C)</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-9 h-9 rounded-full bg-brand-green text-brand-bg flex items-center justify-center">✓</span>
              <span class="font-semibold">Shake well before drinking</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-9 h-9 rounded-full bg-brand-green text-brand-bg flex items-center justify-center">✓</span>
              <span class="font-semibold">Consume within 24h of opening</span>
            </div>
          </div>
        </div>

        <div class="mt-8 rounded-2xl bg-brand-bg p-5">
          <p class="text-xs font-black uppercase tracking-widest text-brand-accent">Manufactured by</p>
          <p class="font-bold mt-1">INNOFUN Co., Ltd.</p>
          <p class="text-sm mt-1">Phnom Penh, Cambodia</p>
        </div>
      </div>
    </section>

    <!-- STORY / CTA -->
    <section id="story" class="max-w-7xl mx-auto mt-12 rounded-[30px] bg-brand-green text-brand-bg p-8 sm:p-12 text-center relative overflow-hidden">
      <div class="absolute -left-6 -top-8 text-7xl opacity-20">🍍</div>
      <div class="absolute -right-5 -bottom-8 text-7xl opacity-20">🍉</div>

      <p class="text-xs font-black uppercase tracking-[.25em] text-brand-lime">INNOFUN DRINK</p>
      <h2 class="display-font text-5xl sm:text-6xl uppercase mt-2">Local. Fresh. Pure.</h2>
      <p class="max-w-2xl mx-auto mt-4 text-sm sm:text-base leading-7 opacity-90">
        Discover a refreshing Greek yogurt drink collection inspired by
        real fruit and locally sourced ingredients.
      </p>

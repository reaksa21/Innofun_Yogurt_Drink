    <!-- NUTRITION -->
    <section class="max-w-7xl mx-auto mt-12 grid lg:grid-cols-2 gap-6">

      <div class="bg-brand-cream rounded-[30px] p-7 sm:p-9 border border-brand-green/10">
        <div class="flex items-end justify-between gap-4 border-b-4 border-brand-green pb-4">
          <div>
            <p class="text-xs font-black uppercase tracking-widest">Nutrition Facts</p>
            <h3 id="nutritionFlavor" class="display-font text-4xl uppercase mt-1">Watermelon</h3>
          </div>

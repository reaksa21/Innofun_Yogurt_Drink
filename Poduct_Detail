  <!-- MOBILE MENU -->
  <button id="menuButton" aria-label="Open menu"
    class="lg:hidden fixed bottom-5 right-5 w-14 h-14 rounded-full bg-brand-green text-brand-bg shadow-lg flex items-center justify-center z-50">
    <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M4 7h16M4 12h16M4 17h16"/>
    </svg>
  </button>

  <script>
    const products = {
      watermelon: {
        name: "Watermelon",
        fruit: "🍉",
        bg: "linear-gradient(145deg,#f8d8dc,#dff0a4)",
        labelBg: "#f9e9e9",
        description: "Creamy Greek yogurt meets juicy watermelon. Made with locally sourced ingredients and carefully blended for a refreshing yogurt drink with a naturally fruity taste.",
        ingredients: "Fresh local milk, authentic Greek yogurt cultures, banana, natural Cambodian palm sugar, and live probiotics.",
        calories: "140",
        fat: "4.3 g",
        satFat: "3 g",
        cholesterol: "10 mg",
        sodium: "40 mg",
        carbs: "19 g",
        sugars: "17 g",
        protein: "8 g",
        calcium: "120 mg"
      },
      mango: {
        name: "Mango",
        fruit: "🥭",
        bg: "linear-gradient(145deg,#ffe4a3,#dff0a4)",
        labelBg: "#fff0bd",
        description: "Creamy Greek yogurt meets sweet, juicy mango. Made with locally sourced ingredients and carefully blended for a refreshing yogurt drink with a naturally fruity taste.",
        ingredients: "Fresh local milk, authentic Greek yogurt cultures, banana, natural Cambodian palm sugar, and live probiotics.",
        calories: "221",
        fat: "6.0 g",
        satFat: "5.3 g",
        cholesterol: "15 mg",
        sodium: "55 mg",
        carbs: "28 g",
        sugars: "17 g",
        protein: "16 g",
        calcium: "160 mg"
      },
      pineapple: {
        name: "Pineapple",
        fruit: "🍍",
        bg: "linear-gradient(145deg,#fff0a9,#dff0a4)",
        labelBg: "#fff4c9",
        description: "Creamy Greek yogurt meets tropical pineapple. Made with locally sourced ingredients and carefully blended for a refreshing yogurt drink with a naturally fruity taste.",
        ingredients: "Fresh local milk, authentic Greek yogurt cultures, banana, natural Cambodian palm sugar, and live probiotics.",
        calories: "180",
        fat: "5 g",
        satFat: "3 g",
        cholesterol: "10 mg",
        sodium: "45 mg",
        carbs: "29 g",
        sugars: "14 g",
        protein: "8 g",
        calcium: "130 mg"
      },
      banana: {
        name: "Banana",
        fruit: "🍌",
        bg: "linear-gradient(145deg,#fff0b5,#dff0a4)",
        labelBg: "#fff4cf",
        description: "Creamy Greek yogurt meets smooth, naturally sweet banana. Made with locally sourced ingredients and carefully blended for a refreshing yogurt drink with a naturally fruity taste.",
        ingredients: "Fresh local milk, authentic Greek yogurt cultures, banana, natural Cambodian palm sugar, and live probiotics.",
        calories: "221",
        fat: "6.0 g",
        satFat: "5.3 g",
        cholesterol: "15 mg",
        sodium: "55 mg",
        carbs: "28 g",
        sugars: "17 g",
        protein: "16 g",
        calcium: "160 mg"
      }
    };

    const buttons = document.querySelectorAll(".flavor-btn");
    const visual = document.getElementById("visual");
    const fruit = document.getElementById("fruit");
    const miniFruit = document.getElementById("miniFruit");
    const bottle = document.getElementById("bottle");
    const labelFlavor = document.getElementById("labelFlavor");

    function selectFlavor(key) {
      const p = products[key];

      buttons.forEach(btn => btn.classList.toggle("active", btn.dataset.flavor === key));

      visual.style.background = p.bg;
      fruit.textContent = p.fruit;
      miniFruit.textContent = p.fruit;
      bottle.querySelector("div").style.background = p.labelBg;
      labelFlavor.textContent = p.name.toUpperCase();

      document.getElementById("productName").textContent = p.name;
      document.getElementById("description").textContent = p.description;
      document.getElementById("ingredientsText").textContent = p.ingredients;
      document.getElementById("nutritionFlavor").textContent = p.name;

      document.getElementById("calories").textContent = p.calories;
      document.getElementById("fat").textContent = p.fat;
      document.getElementById("satFat").textContent = p.satFat;
      document.getElementById("cholesterol").textContent = p.cholesterol;
      document.getElementById("sodium").textContent = p.sodium;
      document.getElementById("carbs").textContent = p.carbs;
      document.getElementById("sugars").textContent = p.sugars;
      document.getElementById("protein").textContent = p.protein;
      document.getElementById("calcium").textContent = p.calcium;
    }

    buttons.forEach(btn => {
      btn.addEventListener("click", () => selectFlavor(btn.dataset.flavor));
    });

    let quantity = 1;
    document.getElementById("plus").addEventListener("click", () => {
      quantity++;
      document.getElementById("quantity").textContent = quantity;
    });
    document.getElementById("minus").addEventListener("click", () => {
      if (quantity > 1) quantity--;
      document.getElementById("quantity").textContent = quantity;
    });

    document.getElementById("menuButton").addEventListener("click", () => {
      const existing = document.getElementById("mobileMenu");
      if (existing) {
        existing.remove();
        return;
      }

      const menu = document.createElement("div");
      menu.id = "mobileMenu";
      menu.className = "fixed bottom-24 right-5 w-64 bg-brand-bg border border-brand-green rounded-3xl p-4 shadow-2xl z-50 flex flex-col gap-2";

      [
        ["Our Drink", "index.html"],
        ["Ingredients", "#ingredients"],
        ["Contact us", "#contact"],
        ["Our Production", "#production"],
        ["About Us", "about-us.html"],
        ["Our Story", "#story"],
        ["Product Detail", "#product-detail"]
      ].forEach(([name, href]) => {
        const a = document.createElement("a");
        a.href = href;
        a.textContent = name;
        a.className = "border border-brand-green rounded-full px-4 py-3 text-sm font-bold hover:bg-brand-green hover:text-brand-bg transition";
        menu.appendChild(a);
      });

      document.body.appendChild(menu);
    });
  </script>
</body>
</html>

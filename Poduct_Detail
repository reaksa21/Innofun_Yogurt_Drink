        </div>

        <div class="mt-2">
          <div class="nutrition-row flex justify-between py-2 border-b border-brand-green/15 text-sm">
            <span>Total Fat</span><strong id="fat">4.3 g</strong>
          </div>
          <div class="nutrition-row flex justify-between py-2 border-b border-brand-green/15 text-sm">
            <span>Saturated Fat</span><strong id="satFat">3 g</strong>
          </div>
          <div class="nutrition-row flex justify-between py-2 border-b border-brand-green/15 text-sm">
            <span>Cholesterol</span><strong id="cholesterol">10 mg</strong>
          </div>
          <div class="nutrition-row flex justify-between py-2 border-b border-brand-green/15 text-sm">
            <span>Sodium</span><strong id="sodium">40 mg</strong>
          </div>
          <div class="nutrition-row flex justify-between py-2 border-b border-brand-green/15 text-sm">
            <span>Total Carbohydrate</span><strong id="carbs">19 g</strong>
          </div>
          <div class="nutrition-row flex justify-between py-2 border-b border-brand-green/15 text-sm">
            <span>Total Sugars</span><strong id="sugars">17 g</strong>
          </div>
          <div class="nutrition-row flex justify-between py-2 border-b border-brand-green/15 text-sm">
            <span>Protein</span><strong id="protein">8 g</strong>

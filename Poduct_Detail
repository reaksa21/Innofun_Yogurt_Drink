            </p>

            <!-- GOODNESS -->
            <div class="mt-8">
              <h3 class="display-font text-2xl uppercase">Goodness Inside</h3>

              <div class="grid grid-cols-2 gap-3 mt-4">
                <div class="benefit-card bg-brand-bg border border-brand-green/15 rounded-2xl p-4">
                  <div class="text-2xl">🦠</div>
